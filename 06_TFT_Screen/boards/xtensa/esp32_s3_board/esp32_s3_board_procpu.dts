/dts-v1/;

#include <espressif/esp32s3/esp32s3_wroom_n8r8.dtsi>
#include <espressif/partitions_0x0_amp.dtsi>
#include "esp32_s3_board-pinctrl.dtsi"
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

/ {
    aliases {
        bl-led = &led_bl;          /* 已有 aliases 的话就追加这行 */
    };

    leds {
        compatible = "gpio-leds";
        led_bl: led_bl {
            gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
        };
    };

    chosen {
        zephyr,sram = &sram1;
        zephyr,flash = &flash0;
        zephyr,console = &uart0;
        zephyr,shell-uart = &uart0;
        zephyr,display = &st7796s;
    };

    mipi_dbi {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&spi2>;
        dc-gpios = <&gpio0 9 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
        #address-cells = <1>;
        #size-cells = <0>;
        write-only;
        status = "okay";

        st7796s: st7796s@0 {
            compatible = "sitronix,st7796s";
            reg = <0>;
            mipi-max-frequency = <40000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            width = <480>;
            height = <320>;
            madctl = <0x68>; /* MV|MX|BGR: 480x320 landscape */
            pgc = [F0 00 03 08 0B 08 11 08 45 26 94 97 45 45];
            ngc = [F0 00 02 06 09 07 0D 08 45 26 94 97 45 45];
        };
    };
};

&gpio0 { status = "okay"; };

&wifi {
    status = "okay";
};

&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-names = "default";
};

&spi2 {
    #address-cells = <1>;
    #size-cells = <0>;
    cs-gpios = <&gpio0 10 GPIO_ACTIVE_LOW>;
    clock-frequency = <40000000>;
    pinctrl-0 = <&spim2_default>;
    pinctrl-names = "default";
    status = "okay";
};

&i2c0 {
    #address-cells = <1>;
    #size-cells = <0>;
    clock-frequency = <400000>;
    pinctrl-0 = <&i2c0_default>;
    pinctrl-names = "default";
    status = "okay";

    ft6336u: focaltech,ft5336@38 {
        compatible = "focaltech,ft5336";
        reg = <0x38>;
        int-gpios = <&gpio0 16 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        reset-gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
        screen-width = <480>;
        screen-height = <320>;
        status = "okay";
    };
};